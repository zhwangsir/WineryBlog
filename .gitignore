node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# Static assets - keep small generated SVG defaults tracked,
# large media uploads stay out of git
public/images/**
!public/images/**/
!public/images/**/*.svg

# HuTao theme media (~300MB) works locally only; upload equivalents
# via the admin panel or serve from a CDN when deploying
public/images/HuTao/*.png
public/images/HuTao/*.jpeg
public/videos/
public/audio/
*.png
*.jpg
*.jpeg
*.gif
*.webp
*.mp4
*.mp3
*.wav
*.ico
*.cur
# small theme essentials stay tracked (negations must come after the
# global extension rules above to win)
!public/images/favicon.ico
!public/images/cursor.cur

# user uploads (avatar/background settings)
server/data/uploads/

# self-hosted gallery images (local disk only, served at /images/)
server/data/gallery/
